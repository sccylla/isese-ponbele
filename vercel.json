{
  "rewrites": [
    {
      "source": "/orisa/:slug",
      "destination": "/api/orisa?slug=:slug"
    },
    {
      "source": "/word/:slug",
      "destination": "/api/word?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/word/:slug",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/orisa/:slug",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
